# ── Frontend: variables de entorno ──────────────────────────────
# Copia este archivo a `.env.local` para desarrollo local.

# URL base del API Gateway (NestJS, puerto 3000 en docker-compose).
# Si se deja vacía o no es una URL http(s) válida, la app arranca
# automáticamente en MODO DEMO con datos locales, sin backend.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Fuerza el modo demo aunque haya un gateway configurado.
# Útil para deploys de solo-frontend (por ejemplo en Vercel).
# NEXT_PUBLIC_DEMO_MODE=true

# URL pública del sitio. Se usa para las etiquetas OpenGraph y el favicon
# absoluto. En Vercel se define como variable de entorno del proyecto.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app
